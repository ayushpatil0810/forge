# VHS tape for Forge AI coding agent demo
# Requirements: vhs, ffmpeg, ttyd
Output docs/demo/demo.gif

Set Shell "bash"
Set FontSize 14
Set Width 1200
Set Height 750
Set Theme "TokyoNight"
Set Padding 16

Type "forge --demo"
Sleep 500ms
Enter

Sleep 2s
Type "Fix the failing test in this workspace"
Sleep 800ms
Enter

Sleep 8s
Sleep 2s
